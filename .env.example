# ============================================================================
# ENTITY PLATFORM (كِـيَـان) - ENVIRONMENT VARIABLES
# ============================================================================

# Application Port
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL / SQLite)
# For local PostgreSQL:
DATABASE_URL=postgresql://entity_user:entity_password@localhost:5432/entity_db
# For SQLite mode:
SQLITE_DB_PATH=./entity_database.sqlite

# Physical File Storage Configuration
STORAGE_ROOT=./storage
STORAGE_MAX_UPLOAD_SIZE_MB=500

# Optional: Gemini API Key for Scholarly Analysis & Meter Verification
GEMINI_API_KEY=

# Application Public Host URL
APP_URL=http://localhost:3000
